# Firmware build output (arduino-cli)
.build/
*.elf
*.map

# Swift package build output
ios/FlockCore/.build/
.swiftpm/

# Xcode. The .xcodeproj is generated by xcodegen from project.yml and is not
# committed: it is large, merge-hostile, and would carry a developer team ID
# into a public repo. Regenerate with `cd ios/FlockSquawk && xcodegen generate`.
*.xcodeproj/
Signing.local.xcconfig
# Also generated from project.yml -- do not edit or commit, it will be clobbered.
ios/FlockSquawk/Info.plist
*.xcuserstate
xcuserdata/
DerivedData/
*.xcodeproj/project.xcworkspace/xcuserdata/

# macOS
.DS_Store

# Local configuration — never commit a real backend URL or credentials
*.local
.env
